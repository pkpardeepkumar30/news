{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nazar India processed news",
  "type": "object",
  "required": ["stories"],
  "properties": {
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "category", "title", "summary", "why_it_matters", "location",
          "published_at", "updated_at", "underreported_score", "evidence_status",
          "confidence", "image", "sources"
        ],
        "properties": {
          "id": {"type": "string"},
          "category": {
            "type": "string",
            "enum": [
              "Politics & Governance", "States & Local", "Economy & Employment",
              "Society, Rights & Justice", "Environment, Health & Science", "Sports"
            ]
          },
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "location": {"type": "string"},
          "published_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "underreported_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "evidence_status": {"type": "string"},
          "confidence": {
            "type": "object",
            "required": ["level", "score", "rationale"],
            "properties": {
              "level": {"enum": ["High", "Medium", "Low"]},
              "score": {"type": "integer", "minimum": 0, "maximum": 100},
              "rationale": {"type": "string"}
            }
          },
          "disagreements": {"type": "array", "items": {"type": "string"}},
          "image": {
            "type": "object",
            "required": ["url", "alt"],
            "properties": {"url": {"type": "string"}, "alt": {"type": "string"}}
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type", "role", "url"],
              "properties": {
                "name": {"type": "string"},
                "type": {"enum": ["independent", "local", "social", "government", "mainstream", "primary_document"]},
                "role": {"type": "string"},
                "url": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
